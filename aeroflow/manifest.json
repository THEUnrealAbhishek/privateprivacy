{
    "manifest_version": 3,
    "name": "AeroFlow",
    "description": "Privacy-first browser extension that protects sensitive information on untrusted websites.",
    "version": "1.0.0",
    "icons": {
        "32": "icon32.png"
    },
    "action": {
        "default_popup": "index.html"
    },
    "permissions": [
        "storage",
        "activeTab"
    ],
    "host_permissions": [
        "http://*/*",
        "https://*/*"
    ],
    "content_scripts": [
        {
            "matches": [
                "http://*/*",
                "https://*/*"
            ],
            "js": [
                "core/website-detector.js",
                "core/trust-engine.js",
                "core/pii-detector.js",
                "core/privacy-engine.js",
                "content.js"
            ],
            "run_at": "document_start"
        }
    ],
    "background": {
        "service_worker": "service-worker.js"
    }
}