{
    "manifest_version": 3,
    "name": "AeroFlow",
    "description": "Privacy-first AI browser agent. Detects and redacts PII locally before any network transmission.",
    "version": "1.0.0",
    "icons": {
        "32": "icon32.png"
    },
    "background": {
        "service_worker": "service-worker.js",
        "type":"module"
    },
    "action":{},
    "permissions": [
        "scripting"
    ],
    "host_permissions":[
        "http://*/*",
        "https://*/*"
    ]
}
